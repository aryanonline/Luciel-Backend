# Shell scripts run inside Linux containers (Dockerfile, docker-compose.yml, ECS tasks), so
# they keep LF line endings even in a Windows checkout with core.autocrlf=true; a CRLF
# script fails there with "/usr/bin/env: 'bash\r': No such file or directory".
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
