# Luciel Backend — environment template (SAFE to commit; copy to .env).
# No real secret is committed. Secret MATERIAL for external connections lives in
# AWS Secrets Manager / SSM (Architecture §3.8.3) — Postgres stores only pointers.
# The values below are process/runtime config.

# --- Run Luciel on your computer (`docker compose up`) -----------------------
# The Docker stack needs at least ONE AI key and reads it from your .env (never
# from this template, and .env is never committed). The key only reaches the
# Luciel containers on your computer. An OpenAI key also powers knowledge search
# (embeddings); Anthropic has no embeddings API, so with only an Anthropic key the
# search uses Luciel's built-in keyword vectors.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: where the Luciel-Frontend checkout is, if it is not beside this
# repository (the default is ../Luciel-Frontend).
# LUCIEL_FRONTEND_SOURCE=../Luciel-Frontend
# Optional: another password for the demo account (8+ characters).
# LUCIEL_DEMO_PASSWORD=luciel-demo

# --- Database (app connects as the NON-superuser, NON-BYPASSRLS app role) ---
LUCIEL_DATABASE_URL=postgresql+asyncpg://luciel_app:luciel_dev_pw@127.0.0.1:5432/luciel_dev
LUCIEL_DATABASE_URL_SYNC=postgresql+psycopg://luciel_app:luciel_dev_pw@127.0.0.1:5432/luciel_dev

# --- Redis ---
LUCIEL_REDIS_URL=redis://127.0.0.1:6379/0

# --- Session / cookies ---
# JWT signing key: in prod this is injected from Secrets Manager. Dev placeholder only.
LUCIEL_JWT_SIGNING_KEY=dev-only-not-a-secret-rotate-in-prod
LUCIEL_SESSION_COOKIE_NAME=luciel_session
# Set to false ONLY for local http development (the frontend over http://localhost).
LUCIEL_COOKIE_SECURE=true
LUCIEL_COOKIE_SAMESITE=lax

# --- CORS: the dashboard origin(s) that send credentials:'include' ---
# JSON array form for pydantic-settings list parsing.
LUCIEL_DASHBOARD_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LUCIEL_ENVIRONMENT=development

# --- LLM integration mode (GATE 2 cutover) ---
# "mock" (default) = deterministic EchoModel, no external keys, no network.
# "live" = real Anthropic/OpenAI providers + Redis cap + Secrets Manager backend.
# Flip to "live" ONLY after the platform secret is populated and DPA/no-training
# terms are confirmed.
LUCIEL_INTEGRATION_MODE=mock
# JSON blob injected from AWS Secrets Manager in deployed environments. In live mode
# it carries {"ANTHROPIC_API_KEY":"...","OPENAI_API_KEY":"..."}. On your own computer
# put your AI key in OPENAI_API_KEY / ANTHROPIC_API_KEY at the top of this file
# instead: the Docker stack builds this blob from them (LUCIEL_LLM_POSTURE=live).
LUCIEL_PLATFORM_SECRET={}
# AWS region for the live SecretsManagerStore backend. Residency is Canada-only
# (Arch §4.2, Decision #21) — ca-central-1 is the ONLY production region.
LUCIEL_AWS_REGION=ca-central-1
# Stripe seam: "mock" (default) = FakeStripeGateway, no keys, no network. "test" =
# RealStripeGateway against Stripe TEST keys from the platform secret. Never "live".
LUCIEL_STRIPE_INTEGRATION_POSTURE=mock
# The Stripe metered PRICE id the PAYG overage subscription item is bound to. Empty
# (the default) means PAYG usage is NOT reported at all — the gateway returns no
# subscription and reporting stays silent rather than billing at a guessed price.
# Correct to leave empty in mock mode. Required before real PAYG billing works: create
# a metered/usage-based recurring price in the Stripe dashboard for the $39-per-100
# -conversation block and paste its id here (or as STRIPE_PAYG_PRICE_ID in the
# platform secret). It is an account-specific object id, so there is no default.
LUCIEL_STRIPE_PAYG_PRICE_ID=
# In-dashboard notices published to every account on next login (Legal §A5/§A10/§B6).
# JSON array; noticeId must be stable per announcement (it is the dismissal key), kind
# is one of allowance_reduction|price_change|terms_change. Empty = nothing published.
# e.g. [{"noticeId":"price:2026-09-01","kind":"price_change","title":"...",
#        "body":"...","effectiveAt":"2026-09-01T00:00:00Z","learnMoreHref":"/billing"}]
LUCIEL_PLATFORM_NOTICES=
# Platform-controlled model IDs (admins can never set these). MUST match the
# defaults in app/config.py — this file drifted once (sonnet-4-5 / gpt-4o) and
# a new deploy copied the stale pins. Precedence: env var > platform-secret
# blob (LLM_ANTHROPIC_PRIMARY_MODEL etc.) > code default — so a model
# retirement is normally handled by rotating the platform secret + restarting
# ECS, with these env lines left unset in deployed environments.
LUCIEL_LLM_ANTHROPIC_PRIMARY_MODEL=claude-sonnet-4-6
LUCIEL_LLM_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
LUCIEL_LLM_OPENAI_FALLBACK_MODEL=gpt-5.4
